generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum RepoStatus {
    INDEXING
    READY
    FAILED
}

model Repository {
    id        String     @id @default(uuid())
    repoUrl   String     @unique
    name      String
    createdAt DateTime   @default(now())
    summary   String?
    status    RepoStatus @default(INDEXING)

    files File[]
}

model File {
    id     String @id @default(uuid())
    path   String
    repoId String

    repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
    embedding  Json?

    chunks  Chunk[]
    symbols Symbol[]

    @@index([repoId])
}

model Chunk {
    id        String @id @default(uuid())
    content   String
    embedding Json
    fileId    String

    file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@index([fileId])
}

model Symbol {
    id     String @id @default(uuid())
    name   String
    type   String
    fileId String
    line   Int

    file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@index([fileId])
}
