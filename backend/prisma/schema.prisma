generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Repository {
    id        String   @id @default(uuid())
    repoUrl   String   @unique
    name      String
    createdAt DateTime @default(now())
    summary   String?

    files File[]
}

model File {
    id     String @id @default(uuid())
    path   String
    repoId String

    repository Repository @relation(fields: [repoId], references: [id])
    embedding  Json?

    chunks  Chunk[]
    symbols Symbol[]
}

model Chunk {
    id        String @id @default(uuid())
    content   String
    embedding Json
    fileId    String
    file      File   @relation(fields: [fileId], references: [id])
}

model Symbol {
    id     String @id @default(uuid())
    name   String
    type   String
    fileId String
    file   File   @relation(fields: [fileId], references: [id])
    line   Int
}
